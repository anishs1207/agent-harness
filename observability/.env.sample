# Model provider (OpenRouter exposes an OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-4.1-mini

# Runtime
APP_ENV=development
AGENT_API_KEY=change-me
CHECKPOINT_DB=agent-checkpoints.sqlite
MAX_INPUT_CHARS=12000
MAX_MODEL_RETRIES=3
RECURSION_LIMIT=25

# LangSmith (leave LANGSMITH_TRACING=false to disable)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=production-agent

# Langfuse (tracing is enabled when both keys are present)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
