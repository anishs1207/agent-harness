# Anthropic API Key (Required for Claude LLM access)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model to run (e.g. claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-7-sonnet-20250219)
MODEL=claude-3-5-sonnet-20241022

# Optional model used by the coding-agent harness (falls back to MODEL)
CODING_MODEL=claude-sonnet-4-6

# Optional Markdown instruction layer (defaults to prompts/PI.md)
CODING_INSTRUCTIONS=prompts/PI.md

# Optional coding-agent loop guardrail
MAX_ITERATIONS=30

# Approval policy for coding-agent writes and commands: prompt, auto, or deny
CODING_APPROVAL=prompt

# OpenRouter credentials and optional pinned Jev decision-model version
OPENROUTER_API_KEY=your_openrouter_api_key_here
JEV_MODEL=typesafe/jev-1.13

# Run Chromium without a visible window (recommended for CI/evals)
HEADLESS=true

# Hacker News Credentials (Required if upvoting encounters login wall)
HN_USERNAME=your_hn_username
HN_PASSWORD=your_hn_password
